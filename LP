<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Studio — VisualFX | Designer Gráfico</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* ── RESET & BASE ─────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Paleta Moderna Dark / Glow */
      --bg-base:     #0A0A0E;
      --surface:     rgba(255, 255, 255, 0.03);
      --surface-hov: rgba(255, 255, 255, 0.08);
      --text-main:   #F8F7F4;
      --text-mid:    #A1A1AA;
      --border:      rgba(255, 255, 255, 0.1);
      
      /* Gradiente e Brilho */
      --accent-1:    #FF2E63;
      --accent-2:    #6366F1;
      --gradient:    linear-gradient(135deg, var(--accent-1), var(--accent-2));
      --glow:        rgba(99, 102, 241, 0.4);

      --bebas:       'Bebas Neue', sans-serif;
      --inter:       'Inter', sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: var(--inter);
      cursor: none;
      overflow-x: hidden;
      position: relative;
    }

    /* ── EFEITO AURORA / GLOW NO FUNDO ────────────── */
    body::before, body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(120px);
      z-index: -1;
      opacity: 0.4;
      animation: pulseGlow 10s ease-in-out infinite alternate;
    }
    body::before {
      top: -10%; left: -10%;
      width: 50vw; height: 50vw;
      background: radial-gradient(circle, rgba(255,46,99,0.3) 0%, transparent 70%);
    }
    body::after {
      bottom: -10%; right: -10%;
      width: 60vw; height: 60vw;
      background: radial-gradient(circle, rgba(99,102,241,0.3) 0%, transparent 70%);
      animation-delay: -5s;
    }

    @keyframes pulseGlow {
      0% { transform: scale(1); opacity: 0.3; }
      100% { transform: scale(1.1); opacity: 0.5; }
    }

    /* ── UTILITÁRIO DE TEXTO GRADIENTE ────────────── */
    .text-gradient {
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }

    /* ── CURSOR PERSONALIZADO ─────────────────────── */
    #cursor {
      position: fixed;
      width: 12px;
      height: 12px;
      background: var(--accent-1);
      box-shadow: 0 0 15px var(--accent-1);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: transform 0.15s ease, width 0.25s ease, height 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }
    #cursor.expand {
      width: 50px;
      height: 50px;
      background: rgba(255, 46, 99, 0.1);
      border: 1px solid var(--accent-1);
      box-shadow: 0 0 20px rgba(255, 46, 99, 0.3) inset;
      backdrop-filter: blur(2px);
    }

    /* ── NAV ──────────────────────────────────────── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 48px;
      background: rgba(10, 10, 14, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s, background 0.3s;
    }
    nav.scrolled { 
      border-color: var(--border); 
      background: rgba(10, 10, 14, 0.85);
    }

   .nav-logo {
      display: flex;
      align-items: center;
      text-decoration: none;
    }
    
    .nav-logo img {
      height: 32px; /* Ajuste este valor para deixar o logo maior ou menor */
      width: auto;
      object-fit: contain;
      transition: transform 0.3s ease, filter 0.3s ease;
    }
    
    /* Efeito sutil ao passar o mouse para manter a estética Glow */
    .nav-logo img:hover {
      transform: scale(1.05);
      filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.3));
    }

    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }
    .nav-links a {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-mid);
      text-decoration: none;
      transition: color 0.2s, text-shadow 0.2s;
    }
    .nav-links a:hover { 
      color: var(--text-main); 
      text-shadow: 0 0 8px rgba(255,255,255,0.3);
    }

    .nav-cta {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-main);
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 10px 24px;
      border-radius: 30px;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .nav-cta:hover { 
      background: var(--gradient);
      border-color: transparent;
      box-shadow: 0 4px 20px var(--glow);
    }

    /* ── HERO ─────────────────────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 420px;
      align-items: end;
      /* Ajuste o padding aqui: aumentamos o espaço inferior para 120px */
      padding: 120px 48px 120px; 
      gap: 48px;
      position: relative;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-mid);
      margin-bottom: 28px;
      opacity: 0;
      transform: translateY(12px);
      animation: fadeUp 0.6s ease 0.2s forwards;
    }
    .hero-eyebrow::before {
      content: '';
      display: block;
      width: 28px;
      height: 2px;
      background: var(--gradient);
      border-radius: 2px;
    }

    .hero-title {
      font-family: var(--bebas);
      font-size: clamp(80px, 10vw, 148px);
      line-height: 0.92;
      letter-spacing: -1px;
      color: var(--text-main);
      opacity: 0;
      transform: translateY(20px);
      animation: fadeUp 0.7s ease 0.35s forwards;
    }

    .hero-sub {
      margin-top: 36px;
      font-size: 16px;
      font-weight: 300;
      line-height: 1.7;
      color: var(--text-mid);
      max-width: 460px;
      opacity: 0;
      transform: translateY(12px);
      animation: fadeUp 0.6s ease 0.55s forwards;
    }

    .hero-actions {
      margin-top: 48px;
      display: flex;
      align-items: center;
      gap: 28px;
      opacity: 0;
      transform: translateY(12px);
      animation: fadeUp 0.6s ease 0.7s forwards;
    }
    
    .btn-primary {
      display: inline-block;
      padding: 16px 36px;
      background: var(--gradient);
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 30px;
      box-shadow: 0 4px 15px var(--glow);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover { 
      transform: translateY(-2px); 
      box-shadow: 0 8px 25px rgba(255, 46, 99, 0.5);
    }

    .btn-ghost {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-main);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      padding-bottom: 2px;
      transition: color 0.2s, border-color 0.2s, text-shadow 0.2s;
    }
    .btn-ghost:hover { 
      color: var(--accent-1); 
      border-color: var(--accent-1); 
      text-shadow: 0 0 10px rgba(255,46,99,0.3);
    }

    /* Hero right — stat card */
    .hero-right {
      align-self: end;
      opacity: 0;
      transform: translateX(20px);
      animation: fadeRight 0.7s ease 0.8s forwards;
    }
    
    .stat-card {
      border: 1px solid var(--border);
      padding: 40px;
      background: var(--surface);
      backdrop-filter: blur(16px);
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 0;
      border-bottom: 1px solid var(--border);
    }
    .stat-row:first-child { padding-top: 0; }
    .stat-row:last-child { border-bottom: none; padding-bottom: 0; }
    .stat-num {
      font-family: var(--bebas);
      font-size: 52px;
      line-height: 1;
      color: var(--text-main);
    }
    .stat-num span { color: var(--accent-2); }
    .stat-label {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-mid);
      text-align: right;
      max-width: 100px;
      line-height: 1.4;
    }

    /* Scroll indicator */
    .scroll-hint {
      position: absolute;
      bottom: 40px;
      left: 48px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-mid);
      opacity: 0;
      animation: fadeUp 0.6s ease 1.1s forwards;
    }
    .scroll-line {
      width: 1px;
      height: 48px;
      background: var(--border);
      position: relative;
      overflow: hidden;
    }
    .scroll-line::after {
      content: '';
      position: absolute;
      top: -100%; left: 0;
      width: 1px; height: 100%;
      background: var(--gradient);
      animation: scrollLine 1.8s ease-in-out 1.2s infinite;
    }
    @keyframes scrollLine {
      0%   { top: -100%; }
      100% { top: 100%; }
    }

    /* ── TICKER ───────────────────────────────────── */
    .ticker {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
      padding: 14px 0;
      background: rgba(10, 10, 14, 0.4);
      backdrop-filter: blur(5px);
    }
    .ticker-track {
      display: flex;
      gap: 0;
      animation: ticker 22s linear infinite;
      width: max-content;
    }
    .ticker-item {
      white-space: nowrap;
      font-family: var(--bebas);
      font-size: 20px;
      letter-spacing: 3px;
      color: var(--text-mid);
      padding: 0 48px;
    }
    .ticker-item span { 
      color: var(--accent-1); 
      margin-right: 48px;
      text-shadow: 0 0 10px rgba(255,46,99,0.5);
    }
    @keyframes ticker {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ── SEÇÕES GERAIS ────────────────────────────── */
    section { padding: 120px 48px; }

    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-2);
      margin-bottom: 16px;
    }

    .section-title {
      font-family: var(--bebas);
      font-size: clamp(42px, 5vw, 72px);
      line-height: 1;
      letter-spacing: 0.5px;
    }

    /* ── PROJETOS ─────────────────────────────────── */
    .projects-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 64px;
    }
    .projects-link {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-main);
      text-decoration: none;
      border-bottom: 1px solid var(--text-main);
      padding-bottom: 2px;
      transition: color 0.2s, border-color 0.2s;
    }
    .projects-link:hover { 
      color: var(--accent-1); 
      border-color: var(--accent-1); 
    }

    .projects-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px; /* Gap ajustado para os cards de vidro respirarem */
    }

    .project-card {
      position: relative;
      overflow: hidden;
      cursor: none;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
    }
    .project-card:first-child { grid-column: 1 / -1; }
    
    .project-card:hover {
      transform: translateY(-5px);
      border-color: rgba(99, 102, 241, 0.4);
      box-shadow: 0 15px 40px rgba(0,0,0,0.4), 0 0 20px rgba(99,102,241,0.1) inset;
    }

    .project-thumb {
      width: 100%;
      aspect-ratio: 16/9;
      background: linear-gradient(135deg, #2E2E38 0%, #1A1A24 100%);
      transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--bebas);
      font-size: 16px;
      letter-spacing: 4px;
      color: #4A4A5A;
    }
    .project-card:first-child .project-thumb { aspect-ratio: 21/9; }
    .project-card:hover .project-thumb { transform: scale(1.04); }

    .project-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(10,10,14,0.9) 0%, rgba(10,10,14,0) 60%);
      display: flex;
      align-items: flex-end;
      padding: 32px;
    }

    .project-info {
      transform: translateY(12px);
      opacity: 0.8;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .project-card:hover .project-info { transform: translateY(0); opacity: 1; }

    .project-tag {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-1);
      margin-bottom: 8px;
    }
    .project-name {
      font-family: var(--bebas);
      font-size: 28px;
      letter-spacing: 1px;
      color: var(--text-main);
      margin-bottom: 4px;
    }
    .project-desc {
      font-size: 13px;
      color: var(--text-mid);
    }

    /* ── SOBRE ────────────────────────────────────── */
    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 96px;
      align-items: center;
    }

    .about-photo { position: relative; }
    .about-photo-frame {
      width: 100%;
      aspect-ratio: 3/4;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      position: relative;
    }
    .about-photo-placeholder {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(255,46,99,0.1) 0%, rgba(99,102,241,0.1) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--bebas);
      font-size: 18px;
      letter-spacing: 4px;
      color: var(--text-mid);
    }
    .about-photo-tag {
      position: absolute;
      bottom: -16px;
      right: -16px;
      background: var(--gradient);
      color: #fff;
      padding: 20px 24px;
      border-radius: 12px;
      font-family: var(--bebas);
      font-size: 14px;
      letter-spacing: 2px;
      box-shadow: 0 10px 25px rgba(255,46,99,0.4);
    }

    .about-bio {
      font-size: 17px;
      line-height: 1.75;
      color: var(--text-mid);
      margin: 24px 0 36px;
    }
    .about-bio strong { color: var(--text-main); font-weight: 600; }

    .skills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 36px;
    }
    .skill-tag {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-main);
      padding: 12px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      transition: background 0.3s, border-color 0.3s;
    }
    .skill-tag:hover {
      background: var(--surface-hov);
      border-color: rgba(99,102,241,0.3);
    }
    .skill-tag::before {
      content: '';
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent-2);
      flex-shrink: 0;
      box-shadow: 0 0 8px var(--accent-2);
    }

    /* ── SERVIÇOS ─────────────────────────────────── */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 64px;
    }
    .service-item {
      padding: 48px 40px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      backdrop-filter: blur(10px);
      transition: transform 0.3s, background 0.3s, border-color 0.3s, box-shadow 0.3s;
    }
    .service-item:hover { 
      transform: translateY(-5px);
      background: var(--surface-hov);
      border-color: rgba(255,46,99,0.4);
      box-shadow: 0 10px 30px rgba(0,0,0,0.3), 0 0 15px rgba(255,46,99,0.1) inset;
    }

    .service-num {
      font-family: var(--bebas);
      font-size: 16px;
      letter-spacing: 3px;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 28px;
      display: inline-block;
    }
    .service-title {
      font-family: var(--bebas);
      font-size: 32px;
      letter-spacing: 0.5px;
      color: var(--text-main);
      margin-bottom: 16px;
      line-height: 1;
    }
    .service-desc {
      font-size: 14px;
      line-height: 1.7;
      color: var(--text-mid);
    }
    .service-arrow {
      display: block;
      margin-top: 32px;
      font-size: 22px;
      color: var(--accent-1);
      opacity: 0.5;
      transform: translateX(-8px);
      transition: opacity 0.3s, transform 0.3s, text-shadow 0.3s;
    }
    .service-item:hover .service-arrow { 
      opacity: 1; 
      transform: translateX(0); 
      text-shadow: 0 0 10px var(--accent-1);
    }

    /* ── DEPOIMENTOS ──────────────────────────────── */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 64px;
    }
    .testimonial-card {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 16px;
      padding: 40px;
      backdrop-filter: blur(10px);
      transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
    }
    .testimonial-card:hover {
      border-color: rgba(99,102,241,0.4);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .testimonial-quote {
      font-size: 40px;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-family: Georgia, serif;
      line-height: 1;
      margin-bottom: 16px;
    }
    .testimonial-text {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-mid);
      margin-bottom: 32px;
    }
    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .testimonial-avatar {
      width: 44px; height: 44px;
      border-radius: 50%;
      background: var(--surface-hov);
      border: 1px solid rgba(255,255,255,0.1);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--bebas);
      font-size: 14px;
      letter-spacing: 1px;
      color: var(--text-main);
    }
    .author-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
    }
    .author-role {
      font-size: 12px;
      color: var(--text-mid);
    }

    /* ── CLIENTES ─────────────────────────────────── */
    .clients {
      padding: 80px 48px;
      border-top: 1px solid var(--border);
    }
    .clients-label {
      text-align: center;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-mid);
      margin-bottom: 48px;
    }
    .clients-logos {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 64px;
      flex-wrap: wrap;
    }
    .client-logo {
      font-family: var(--bebas);
      font-size: 24px;
      letter-spacing: 3px;
      color: var(--text-mid);
      opacity: 0.4;
      transition: color 0.3s, opacity 0.3s, text-shadow 0.3s;
    }
    .client-logo:hover { 
      color: var(--text-main); 
      opacity: 1;
      text-shadow: 0 0 15px rgba(255,255,255,0.3);
    }

    /* ── CONTATO ──────────────────────────────────── */
    .contact {
      text-align: center;
      padding: 160px 48px;
      position: relative;
    }
    .contact .section-eyebrow { justify-content: center; }
    .contact-title {
      font-family: var(--bebas);
      font-size: clamp(56px, 8vw, 120px);
      line-height: 0.9;
      color: var(--text-main);
      margin: 16px 0 40px;
    }
    .contact-sub {
      font-size: 16px;
      color: var(--text-mid);
      max-width: 440px;
      margin: 0 auto 56px;
      line-height: 1.7;
    }
    .contact-email {
      display: inline-block;
      font-family: var(--bebas);
      font-size: clamp(22px, 3vw, 36px);
      letter-spacing: 2px;
      color: var(--text-main);
      text-decoration: none;
      border-bottom: 2px solid rgba(255,46,99,0.5);
      padding-bottom: 4px;
